# Multi-factor authentication of administrators. Only 0/false/no/off disables it.
# MFA_ADMIN_REQUIRED=
EUPHROSYNE_TOOLS_API_URL=http://localhost:8001
# RSA private key (PEM) signing the tokens Euphrosyne issues (OpenID Connect
# provider); other services read its public key at /.well-known/jwks.json.
# Line breaks may be written as \n. Generate one with:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
IDP_OIDC_PRIVATE_KEY=
# Optional, for key rotation: JSON list of {"pem", "issued_at", "expires_at"}.
IDP_OIDC_PRIVATE_KEYS=
# Secret of the Tools API's OpenID Connect client, equal to the Tools API's
# EUPHROSYNE_OIDC_CLIENT_SECRET. Rotate it by changing both. Generate one with:
# openssl rand -hex 32
OIDC_TOOLS_API_CLIENT_SECRET=

# Optional feature modules (comma-separated).
# Not set = all features enabled (default)
# Empty string = all features disabled
# Available: data_request, lab_notebook, radiation_protection
# EUPHROSYNE_FEATURES=data_request,lab_notebook

